{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lala-voice-agent",
  "main": "worker/index.ts",
  "account_id": "YOUR_ACCOUNT_ID_HERE",
  "compatibility_date": "2026-04-16",
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
  "compatibility_flags": ["nodejs_compat"],
  // Base URL of the ProposalForge app. The agent delegates token verification
  // to <APP_URL>/api/auth/me and forwards send_proposal to its API.
  "vars": {
    "APP_URL": "https://proposal.lalatendu.info",
  },
  "ai": {
    "binding": "AI",
  },
  // Bound to the ProposalForge production database (shared with the web app and
  // MCP server). All tools are scoped to the authenticated user.
  "d1_databases": [
    {
      "binding": "PROPOSALS_DB",
      "database_name": "PROPOSALS_DB",
      "database_id": "YOUR_PROPOSALS_DB_ID_HERE",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VoiceAgent",
        "class_name": "VoiceAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VoiceAgent"],
    },
  ],
  "routes": [
    {
      "pattern": "voiceagent.lalatendu.info/*",
      "zone_name": "lalatendu.info",
    },
    {
      "pattern": "voiceagent.lalatendu.info",
      "zone_name": "lalatendu.info",
    },
  ],
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lala-voice-agent",
  "main": "worker/index.ts",
  "account_id": "YOUR_ACCOUNT_ID_HERE",
  "compatibility_date": "2026-04-16",
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
  "compatibility_flags": ["nodejs_compat"],
  // APP_URL: token is verified by delegating to <APP_URL>/api/auth/me.
  // MCP_URL: proposal tools call this MCP server over HTTP (forwarding the
  // user's token), so the agent needs NO database binding and can run in any
  // account (e.g. a separate one for its own Workers AI quota).
  "vars": {
    "APP_URL": "https://proposal.lalatendu.info",
    "MCP_URL": "https://proposal-mcp-server.lalatendu.workers.dev",
  },
  "ai": {
    "binding": "AI",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VoiceAgent",
        "class_name": "VoiceAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VoiceAgent"],
    },
  ],
  "routes": [
    {
      "pattern": "voiceagent.lalatendu.info/*",
      "zone_name": "lalatendu.info",
    },
    {
      "pattern": "voiceagent.lalatendu.info",
      "zone_name": "lalatendu.info",
    },
  ],
}
